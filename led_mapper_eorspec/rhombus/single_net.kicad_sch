	)
	(text "There are no diodes at the intersection of rows P1-P8 (inclusive) and columns P20-P24 (inclusive).\nThis accounts for the 40 unused wire pairs mentioned in the other note."
		(exclude_from_sim no)
		(at 289.56 190.246 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "805660ea-5823-441b-86e1-06ab77abfb23")
	)
	(text "The large grid section seen here is the upper portion of the square charlieplexed network.\n24 wires each intersect every other wire at a diode, for a total of 24*23 (552) addressable locations.\nNot all locations are needed, since the network has 32*16 (512) pixels. There are 552-512=40 unused wire pairs.\n\nWhen comparing the schematic and the physical LED layout, the diagonal with missing LEDs is collapsed to the left (i.e., the gap removes a column, not a row)."
		(exclude_from_sim no)
		(at 64.77 184.912 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f8047584-f020-4b42-b058-e593d163d853")
	)
